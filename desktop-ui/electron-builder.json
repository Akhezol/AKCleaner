{
  "appId": "com.akcleaner.desktop",
  "productName": "AKCleaner",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "agent/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "msi"],
    "publisherName": "AKCleaner",
    "signingHashAlgorithms": ["sha256"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
